# Absolute origin of the deployed site. Used as `metadataBase`, so canonical
# URLs and the Open Graph / Twitter image resolve to absolute URLs.
# Without it, metadata falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Dev workspace only. These are server secrets; never prefix with NEXT_PUBLIC_.
ATTIO_API_KEY=
# Populated by npm run attio:setup:dev after checking the sandbox workspace.
ATTIO_WORKSPACE_ID=
ATTIO_LIST_ID=

# Required for production builds; npm run dev uses Cloudflare's official test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Created by npm run cloudflare:setup:dev. Used by npm run dev:remote.
TURNSTILE_DEV_SITE_KEY=
TURNSTILE_DEV_SECRET_KEY=
# Saved by npm run leads:deploy:dev.
LEADS_REMOTE_DEV_API_ORIGIN=

# Created by npm run staging:setup; used only by staging:build/staging:deploy.
TURNSTILE_STAGING_SITE_KEY=
TURNSTILE_STAGING_SECRET_KEY=

# Put production credentials in .env.production.local, never in this dev .env.
# ATTIO_API_KEY=<production token>
# TURNSTILE_SECRET_KEY=<production Turnstile secret>
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<matching public site key, used at website build time>
# NEXT_PUBLIC_SITE_URL=<canonical production origin>

# Production only: same random 32+ character secret in the website Worker and
# GitHub production environment. Never use NEXT_PUBLIC_ for this credential.
# SIGNUP_PROBE_SECRET=
