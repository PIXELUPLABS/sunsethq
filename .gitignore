# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out-production/
/workers/site/wrangler.bootstrap.json
/public/generated-images/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars*
.wrangler/
workers/**/.wrangler/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Browser test artifacts
/test-results/
/playwright-report/
/storybook-static/
/artifacts/
