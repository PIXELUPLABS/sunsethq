{
  "name": "sunsethq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "storybook": "storybook dev --port 6006 --host 127.0.0.1 --no-open --exact-port --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-release.mjs",
    "ci:build": "node scripts/build-ci.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "dev:leads": "node scripts/dev.mjs --workers-only",
    "dev:remote": "node scripts/dev.mjs --remote",
    "cloudflare:setup:dev": "node scripts/setup-cloudflare-dev.mjs",
    "attio:setup:dev": "tsx scripts/setup-attio.mts development",
    "attio:setup:prod": "tsx scripts/setup-attio.mts production",
    "test:leads": "tsx --test tests/lead-capture.test.ts tests/pending-submission.test.ts tests/attribution.test.ts tests/unverified-notification.test.ts tests/terminal-delivery.test.ts",
    "test:staging": "tsx --test tests/staging.test.ts",
    "leads:smoke:local": "tsx scripts/smoke-leads.mts",
    "leads:rehearse:dev": "tsx scripts/rehearse-outbox.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "leads:deploy:dev": "tsx scripts/deploy-leads.mjs development",
    "leads:deploy:prod": "tsx scripts/deploy-leads.mjs production",
    "build": "next build",
    "staging:setup": "node scripts/setup-staging.mjs",
    "staging:build": "node scripts/build-staging.mjs",
    "staging:deploy": "node scripts/deploy-staging.mjs",
    "preview:deploy": "node scripts/deploy-preview.mjs",
    "production:setup": "node scripts/setup-production.mjs",
    "production:build": "node scripts/build-production.mjs",
    "production:deploy": "node scripts/deploy-production.mjs",
    "production:deploy:ci": "node scripts/deploy-production-ci.mjs",
    "production:verify": "node scripts/verify-production.mjs",
    "jobs:sync": "tsx scripts/sync-jobs.mts",
    "start": "next start",
    "lint": "eslint",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "agentation": "^3.0.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.63.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^7.3.6",
    "wrangler": "^4.135.0"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "maintained node versions"
  ]
}
